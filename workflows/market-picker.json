        "content": "=const msg = $input.item.json.message || \"\";\n\n// Discord limit is 2000, we use 1900 to be safe with emojis/formatting\nif (msg.length <= 1900) {\n  return [{ \n    json: { \n      part1: msg, \n      part2: \"\" // Explicitly empty string\n    } \n  }];\n}\n\n// Find a good splitting point (last newline before the limit)\nlet splitAt = msg.lastIndexOf('\\n', 1900);\n\n// If no newline found, just force split at 1900\nif (splitAt <= 0) splitAt = 1900;\n\nconst part1 = msg.substring(0, splitAt).trim();\nconst part2 = msg.substring(splitAt).trim();\n\nreturn [{\n  json: {\n    part1: part1,\n    part2: part2\n  }\n}];",
        "options": {}
