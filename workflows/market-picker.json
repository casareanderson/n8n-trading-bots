    {
      "parameters": {
        "jsCode": "// Parse Yahoo RSS feeds - they return XML\nconst parseRSS = (data) => {\n  try {\n    // n8n auto-parses XML to JSON for RSS feeds\n    const items = data.rss?.channel?.item || data.items || [];\n    const arr = Array.isArray(items) ? items : [items];\n    return arr.slice(0, 5).map(i => (i.title || '') + ': ' + (i.description || '').replace(/<[^>]*>/g,'').substring(0,100)).join(' | ');\n  } catch(e) {\n    return JSON.stringify(data).substring(0, 300);\n  }\n};\n\n// Parse CoinGecko data\nconst parseCrypto = (data) => {\n  try {\n    const coins = Array.isArray(data) ? data : [];\n    return coins.slice(0, 5).map(c => \n      `${c.symbol?.toUpperCase()}: $${c.current_price} (${c.price_change_percentage_24h?.toFixed(1)}% 24h)`\n    ).join(' | ');\n  } catch(e) {\n    return JSON.stringify(data).substring(0, 200);\n  }\n};\n\nconst us = $('Scan: US Stocks').item.json;\nconst uk = $('Scan: UK Stocks').item.json;\nconst global = $('Scan: Europe & Asia').item.json;\nconst catalysts = $('Scan: Catalysts & News').item.json;\nconst crypto = $('Scan: Crypto').item.json;\n\nconst usData = parseRSS(us);\nconst ukData = parseRSS(uk);\nconst globalData = parseRSS(global);\nconst catalystData = parseRSS(catalysts);\nconst cryptoData = parseCrypto(crypto);\n\nreturn [{json: {\n  usData: usData || 'No US data',\n  ukData: ukData || 'No UK data',\n  globalData: globalData || 'No global data',\n  catalystData: catalystData || 'No catalyst data',\n  cryptoData: cryptoData || 'No crypto data',\n  timestamp: new Date().toLocaleString('en-GB')\n}}];"
      },
      "id": "YOUR_CREDENTIAL_ID_8",
      "name": "Combine All Scans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const analysis = $input.item.json.message?.content || $input.item.json.content || 'No analysis available';\nconst ts = $('Combine All Scans').item.json.timestamp;\n\nconst message = `\ud83d\udd50 ${ts}\n________________\n\n${analysis}\n\n________________\n_\u2139\ufe0f Information only \u2014 not financial advice. Always do your own research._`;\n\nreturn [{json: {message}}];"
      },
      "id": "YOUR_CREDENTIAL_ID_9",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.item.json.message;\n// Discord limit is 2000 chars - split if needed\nif (msg.length <= 1900) {\n  return [{json: {part1: msg, part2: null}}];\n}\n// Split at a sensible point\nconst splitAt = msg.lastIndexOf('\\n', 1800);\nreturn [{json: {\n  part1: msg.substring(0, splitAt),\n  part2: msg.substring(splitAt)\n}}];"
      },
