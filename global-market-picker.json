    {
      "parameters": {
        "jsCode": "const parseRSS = (nodeData) => {\n  try {\n    const xml = nodeData.data || '';\n    if (!xml) return 'No data';\n    const titles = [...xml.matchAll(/<title>(.*?)<\\/title>/gs)]\n      .map(m => m[1].replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').trim())\n      .filter(t => !t.includes('Yahoo! Finance:') && !t.includes('Yahoo Finance:'))\n      .slice(0, 5);\n    const descriptions = [...xml.matchAll(/<description>(.*?)<\\/description>/gs)]\n      .map(m => m[1].replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').trim().substring(0,100))\n      .filter(d => d.length > 20)\n      .slice(0, 5);\n    return titles.map((t, i) => t + (descriptions[i] ? ': ' + descriptions[i] : '')).join(' | ');\n  } catch(e) {\n    return 'Parse error: ' + e.message;\n  }\n};\n\nconst parseCrypto = (nodeData) => {\n  try {\n    const coins = Array.isArray(nodeData) ? nodeData : [];\n    return coins.slice(0,5).map(c =>\n      `${(c.symbol||'').toUpperCase()}: $${c.current_price} (${(c.price_change_percentage_24h||0).toFixed(1)}% 24h)`\n    ).join(' | ');\n  } catch(e) {\n    return 'No crypto data';\n  }\n};\n\nconst usData = parseRSS($('Scan: US Stocks1').item.json);\nconst ukData = parseRSS($('Scan: UK Stocks1').item.json);\nconst globalData = parseRSS($('Scan: Europe & Asia1').item.json);\nconst catalystData = parseRSS($('Scan: Catalysts & News1').item.json);\nconst cryptoData = parseCrypto($('Scan: Crypto1').item.json);\n\nreturn [{json: {\n  usData,\n  ukData,\n  globalData,\n  catalystData,\n  cryptoData,\n  timestamp: new Date().toLocaleString('en-GB')\n}}];"
      },
